# Rohan Craft House Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Store Configuration
VITE_STORE_NAME="Rohan Craft House"
VITE_CURRENCY_SYMBOL="₹"
VITE_FREE_SHIPPING_THRESHOLD=1999
VITE_STANDARD_SHIPPING_FEE=149

# ==============================================================================
# SERVER-SIDE ONLY: Supabase Edge Function Secrets (send-order-whatsapp-notification)
# IMPORTANT: NEVER prefix these with VITE_ and NEVER commit real secrets to git.
# Configure them in Supabase Dashboard -> Edge Functions -> Secrets, or via CLI:
#   supabase secrets set WHATSAPP_ACCESS_TOKEN=... WHATSAPP_PHONE_NUMBER_ID=... OWNER_WHATSAPP_NUMBER=...
# ==============================================================================
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# OWNER_WHATSAPP_NUMBER=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_GRAPH_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# ==============================================================================
# SERVER-SIDE ONLY: Vercel Serverless Function (/api/whatsapp/webhook)
# Configure in Vercel Dashboard -> Settings -> Environment Variables.
# NEVER prefix these with VITE_ and NEVER commit real secrets to git.
# ==============================================================================
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=


